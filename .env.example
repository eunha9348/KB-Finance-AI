# 이 파일을 .env 로 복사해서 키를 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있어서 커밋되지 않습니다.

# 둘 중 하나만 있어도 실거래가가 반영됩니다.

# 국토교통부 실거래가 (data.go.kr). HTTPS 라 이쪽이 안정적이고, 있으면 우선 사용합니다.
#   data.go.kr → '국토교통부_아파트 매매/전월세 실거래가 자료' → 활용신청(자동승인)
#   → 마이페이지 → 일반 인증키(Encoding) 복사
MOLIT_API_KEY=

# 서울 열린데이터광장 (data.seoul.go.kr) 마이페이지 > 인증키 신청.
# 전세는 잘 되는데 매매 쪽은 ERROR-500 이 잦아서 보조로 씁니다.
SEOUL_API_KEY=

# 둘 다 비어 있으면 폴백 근사값으로 돌아갑니다. 서비스는 정상 동작하고,
# 어떤 지표가 폴백인지는 화면 상단에 표시됩니다.
